<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/orders_widget_panel">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="TallyBridge Orders" android:textColor="#102D44" android:textSize="16sp" android:textStyle="bold" />
        <Button android:id="@+id/widget_refresh" android:layout_width="wrap_content" android:layout_height="40dp" android:text="↻" android:textSize="16sp" android:contentDescription="Refresh pending orders" />
    </LinearLayout>
    <TextView android:id="@+id/widget_pending" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Pending orders: 0" android:textColor="#176B5B" android:textSize="20sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_names" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="2" android:ellipsize="end" android:text="No pending orders" android:textColor="#596C79" android:textSize="12sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
        <Button android:id="@+id/widget_add" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:text="+ Add order" android:textAllCaps="false" />
        <Button android:id="@+id/widget_open" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:layout_marginStart="8dp" android:text="Pending" android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>
