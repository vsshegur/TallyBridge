<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="13dp" android:background="@drawable/orders_widget_panel">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/widget_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TALLYBRIDGE" android:textColor="#176B5B" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.12" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pending orders" android:textColor="#102D44" android:textSize="18sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:id="@+id/widget_mode" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingLeft="7dp" android:paddingTop="3dp" android:paddingRight="7dp" android:paddingBottom="3dp" android:background="@drawable/orders_widget_secondary" android:text="PC SYNCED" android:textColor="#596C79" android:textSize="9sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_refresh" android:layout_width="38dp" android:layout_height="38dp" android:layout_marginStart="6dp" android:gravity="center" android:background="@drawable/orders_widget_secondary" android:text="↻" android:textColor="#176B5B" android:textSize="18sp" android:textStyle="bold" android:contentDescription="Refresh pending orders" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_pending" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#102D44" android:textSize="34sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:text="PENDING" android:textColor="#176B5B" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:id="@+id/widget_party_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:text="NEXT CUSTOMERS" android:textColor="#7A8B96" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.08" />
    <TextView android:id="@+id/widget_party1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="1" android:ellipsize="end" android:text="No pending orders" android:textColor="#102D44" android:textSize="17sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_party2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:maxLines="1" android:ellipsize="end" android:textColor="#394F5F" android:textSize="15sp" />
    <TextView android:id="@+id/widget_party3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:maxLines="1" android:ellipsize="end" android:textColor="#394F5F" android:textSize="15sp" />
    <TextView android:id="@+id/widget_more" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:maxLines="1" android:textColor="#596C79" android:textSize="11sp" android:textStyle="bold" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:orientation="horizontal">
        <TextView android:id="@+id/widget_add" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:gravity="center" android:background="@drawable/orders_widget_primary" android:text="+ New order" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_open" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginStart="8dp" android:gravity="center" android:background="@drawable/orders_widget_secondary" android:text="View pending" android:textColor="#176B5B" android:textSize="13sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
