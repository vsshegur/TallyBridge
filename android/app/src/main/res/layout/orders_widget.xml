<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="15dp" android:background="@drawable/orders_widget_panel">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
  <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TALLYBRIDGE" android:textColor="#176B5B" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.13"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Order Desk" android:textColor="#102D44" android:textSize="19sp" android:textStyle="bold"/></LinearLayout>
  <TextView android:id="@+id/widget_mode" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingLeft="8dp" android:paddingTop="4dp" android:paddingRight="8dp" android:paddingBottom="4dp" android:background="@drawable/orders_widget_secondary" android:text="PC SYNCED" android:textColor="#596C79" android:textSize="9sp" android:textStyle="bold"/>
  <TextView android:id="@+id/widget_refresh" android:layout_width="38dp" android:layout_height="38dp" android:layout_marginStart="7dp" android:gravity="center" android:background="@drawable/orders_widget_secondary" android:text="↻" android:textColor="#176B5B" android:textSize="18sp" android:textStyle="bold" android:contentDescription="Refresh pending orders"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="bottom"><TextView android:id="@+id/widget_pending" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#102D44" android:textSize="32sp" android:textStyle="bold"/><LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="9dp" android:layout_marginBottom="4dp" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ORDERS WAITING" android:textColor="#176B5B" android:textSize="10sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tap a customer or open the desk" android:textColor="#596C79" android:textSize="10sp"/></LinearLayout></LinearLayout>
 <LinearLayout android:id="@+id/widget_party_area" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical">
  <TextView android:id="@+id/widget_party_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="NEXT CUSTOMERS" android:textColor="#596C79" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.08"/>
  <TextView android:id="@+id/widget_party1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:ellipsize="end" android:maxLines="1" android:text="No pending orders" android:textColor="#102D44" android:textSize="14sp" android:textStyle="bold"/>
  <TextView android:id="@+id/widget_party2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:ellipsize="end" android:maxLines="1" android:textColor="#102D44" android:textSize="13sp" android:textStyle="bold"/>
  <TextView android:id="@+id/widget_party3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:ellipsize="end" android:maxLines="1" android:textColor="#102D44" android:textSize="13sp" android:textStyle="bold"/>
  <TextView android:id="@+id/widget_more" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="#596C79" android:textSize="10sp" android:textStyle="bold"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><TextView android:id="@+id/widget_add" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1.25" android:gravity="center" android:background="@drawable/orders_widget_primary" android:text="+ New order" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/><TextView android:id="@+id/widget_gsm" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="0.75" android:layout_marginStart="7dp" android:gravity="center" android:background="@drawable/orders_widget_secondary" android:text="GSM" android:textColor="#176B5B" android:textSize="12sp" android:textStyle="bold"/><TextView android:id="@+id/widget_open" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="0.95" android:layout_marginStart="7dp" android:gravity="center" android:background="@drawable/orders_widget_secondary" android:text="Open desk" android:textColor="#176B5B" android:textSize="12sp" android:textStyle="bold"/></LinearLayout>
</LinearLayout>