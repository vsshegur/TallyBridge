<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/orders_widget_panel_dark">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TALLYBRIDGE • ORDERS" android:textColor="#7BD8BD" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.10"/><LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="bottom"><TextView android:id="@+id/widget_pending" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#E6EDF3" android:textSize="28sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:layout_marginBottom="4dp" android:text="pending" android:textColor="#A7B8C5" android:textSize="11sp"/></LinearLayout></LinearLayout><TextView android:id="@+id/widget_refresh" android:layout_width="38dp" android:layout_height="38dp" android:gravity="center" android:background="@drawable/orders_widget_secondary_dark" android:text="↻" android:textColor="#7BD8BD" android:textSize="18sp" android:textStyle="bold" android:contentDescription="Refresh pending orders"/></LinearLayout>
 <TextView android:id="@+id/widget_mode" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" android:text="PC SYNCED"/>
 <LinearLayout android:id="@+id/widget_party_area" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical"><TextView android:id="@+id/widget_party_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone"/><TextView android:id="@+id/widget_party1" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="No pending orders" android:textColor="#E6EDF3" android:textSize="14sp" android:textStyle="bold"/><TextView android:id="@+id/widget_party2" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone"/><TextView android:id="@+id/widget_party3" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone"/><TextView android:id="@+id/widget_more" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone"/></LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><TextView android:id="@+id/widget_add" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1.2" android:gravity="center" android:background="@drawable/orders_widget_primary_dark" android:text="+ Order" android:textColor="#102D26" android:textSize="12sp" android:textStyle="bold"/><TextView android:id="@+id/widget_gsm" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="0.8" android:layout_marginStart="6dp" android:gravity="center" android:background="@drawable/orders_widget_secondary_dark" android:text="GSM" android:textColor="#7BD8BD" android:textSize="12sp" android:textStyle="bold"/><TextView android:id="@+id/widget_open" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="0.9" android:layout_marginStart="6dp" android:gravity="center" android:background="@drawable/orders_widget_secondary_dark" android:text="Open" android:textColor="#7BD8BD" android:textSize="12sp" android:textStyle="bold"/></LinearLayout>
</LinearLayout>