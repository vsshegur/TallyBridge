<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quick_widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="6dp"
    android:background="@drawable/quick_order_widget_panel" android:contentDescription="New order">
    <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_widget_add"
        android:tint="#7BD8BD" android:importantForAccessibility="no" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp"
        android:text="New order" android:textColor="#FFFFFF" android:textSize="10.5sp" android:textStyle="bold"
        android:maxLines="1" android:ellipsize="end" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp"
        android:text="Works offline" android:textColor="#B9CBD5" android:textSize="7.5sp" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
