<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:baselineAligned="false" android:weightSum="5" android:padding="6dp" android:background="@drawable/quick_dock_bg">
 <LinearLayout android:id="@+id/quick_dock_brand" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.9" android:gravity="center_vertical" android:orientation="horizontal" android:paddingLeft="7dp" android:paddingRight="7dp">
  <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/app_icon" android:contentDescription="TallyBridge"/>
  <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="7dp" android:text="TallyBridge" android:textColor="#F4F8FA" android:textStyle="bold" android:textSize="14sp" android:singleLine="true" android:ellipsize="end"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#53D4B7" android:textStyle="bold" android:textSize="22sp"/>
 </LinearLayout>
 <TextView android:layout_width="1dp" android:layout_height="match_parent" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" android:background="#31576A"/>
 <LinearLayout android:id="@+id/quick_dock_proforma" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="6dp" android:gravity="center" android:orientation="vertical" android:background="@drawable/quick_dock_action">
  <ImageView android:layout_width="23dp" android:layout_height="23dp" android:src="@drawable/ic_widget_proforma" android:contentDescription="Proforma"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Proforma" android:textColor="#F4F8FA" android:textStyle="bold" android:textSize="9sp"/>
 </LinearLayout>
 <LinearLayout android:id="@+id/quick_dock_gsm" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="6dp" android:gravity="center" android:orientation="vertical" android:background="@drawable/quick_dock_action">
  <ImageView android:layout_width="23dp" android:layout_height="23dp" android:src="@drawable/ic_widget_gsm" android:contentDescription="GSM Calculator"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="GSM" android:textColor="#F4F8FA" android:textStyle="bold" android:textSize="9sp"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Calculator" android:textColor="#9FB3C1" android:textSize="7sp"/>
 </LinearLayout>
 <LinearLayout android:id="@+id/quick_dock_order" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="6dp" android:gravity="center" android:orientation="vertical" android:background="@drawable/quick_dock_action">
  <ImageView android:layout_width="23dp" android:layout_height="23dp" android:src="@drawable/ic_widget_add" android:contentDescription="New Order"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="New Order" android:textColor="#F4F8FA" android:textStyle="bold" android:textSize="9sp"/>
 </LinearLayout>
</LinearLayout>
