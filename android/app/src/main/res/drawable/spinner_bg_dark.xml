<?xml version="1.0" encoding="utf-8"?>
<!-- Drop-down field: rounded card like the text fields, with a chevron so it reads as a choice. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#1B2732" />
            <stroke android:width="1dp" android:color="#344552" />
        </shape>
    </item>
    <item android:gravity="end|center_vertical" android:end="14dp" android:width="20dp" android:height="20dp" android:drawable="@drawable/ic_chevron_down_dark" />
</layer-list>
